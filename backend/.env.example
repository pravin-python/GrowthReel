# Copy this file to `.env` (same directory) and fill in real values for
# local development. `.env` is git-ignored — never commit it.
#
# Variables marked "SHARED" below must be set to the SAME value in both this
# Django backend and the sibling FastAPI `api/` service's own env file — see
# "Contract for the FastAPI service" in README.md.

# --- Django core -------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.local
# Generate one with:
#   .venv/Scripts/python.exe -c "import secrets; print(secrets.token_urlsafe(64))"
# This is Django's own internal signing key (sessions, CSRF, password reset
# tokens, ...) — unrelated to SHARED_JWT_SECRET below, and NOT shared with
# the api/ service. Never reuse this placeholder outside local dev.
DJANGO_SECRET_KEY=xWccTzMdLX8rdLCgNJL_4baahJLnWXLIuYtt89Dowm3Exf8U35FkHLzowC10iGeQEd4Kn2WGkLyevPYTV9d0Lg
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- CORS ----------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Django <-> FastAPI bridge (SHARED) ----------------------------------
# HS256 signing secret for the short-lived bridge JWT minted on login, AND
# for the api/ service's own access/refresh tokens (see api/app/core/
# security.py). Generate one with:
#   .venv/Scripts/python.exe -c "import secrets; print(secrets.token_urlsafe(64))"
# Use a value at least 32 bytes (44+ base64/urlsafe characters) of real
# entropy. NEVER reuse this placeholder outside local dev. Copy the exact
# same generated value into api/.env's SHARED_JWT_SECRET too — a bridge
# token minted here is only verifiable there if the two match byte-for-byte.
SHARED_JWT_SECRET=change-me-shared-jwt-secret-min-32-bytes-of-entropy

# Base URL of the React SPA (app.growthreel.com in production). The browser
# is redirected to `${APP_FRONTEND_URL}/auth/callback?token=<bridge_jwt>`
# after a successful Django login.
APP_FRONTEND_URL=http://localhost:5173

# --- Database (used by both config.settings.local AND .production) ------
# One discrete-variable connection config everywhere — no separate
# DATABASE_URL-style value. This file is NOT duplicated into api/.env: when
# the api/ service calls django.setup(), Django reads these values straight
# out of THIS file (via its own BASE_DIR-relative .env lookup), so the two
# processes always agree without copying anything. Point these at a real
# local Postgres instance (e.g. `docker compose up postgres` from the repo
# root, or your own install) — there is no SQLite fallback. Replace with
# your own values; do not reuse these placeholders outside local dev.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=growthreel
DB_USER=growthreel
DB_PASSWORD=growthreel
DB_HOST=localhost
DB_PORT=5432
# Only read by config.settings.production (local.py doesn't set OPTIONS at
# all, i.e. whatever your local Postgres/libpq defaults to). "require" is
# the right default for a real deployment; see production.py's comment.
DB_SSLMODE=require

# --- Redis (SHARED: cache backend here, broker for FastAPI/Celery) ------
REDIS_URL=redis://localhost:6379/0

# --- HTTPS hardening escape hatch (config.settings.production only) -----
# Leave this true (or unset) for any real deployment, which runs behind a
# TLS-terminating proxy. Set to false ONLY for a local docker-compose stack
# served over plain HTTP, so SECURE_SSL_REDIRECT/HSTS/Secure-cookies don't
# break it while still exercising real Postgres/Redis containers.
DJANGO_FORCE_HTTPS=true
