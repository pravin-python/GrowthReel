{
  "name": "growthreel-backend-assets",
  "version": "1.0.0",
  "private": true,
  "description": "Tailwind CSS build for the GrowthReel Django backend's server-rendered templates.",
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i ./static_src/input.css -o ./static/css/tailwind.css --minify",
    "watch:css": "npx @tailwindcss/cli -i ./static_src/input.css -o ./static/css/tailwind.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}
