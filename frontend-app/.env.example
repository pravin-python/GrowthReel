# URL of the Django-powered marketing site (growthreel.com). Used for:
#  - the "back to sign in" link on /login-expired
#  - the redirect target after logout
VITE_MARKETING_SITE_URL=http://localhost:8000

# When "true", intercepts fetch()/WebSocket calls to /api/v1/... with an
# in-memory mock implementation of the FastAPI contract (src/mocks/), so the
# UI can be exercised end-to-end before the real backend exists. Leave unset
# or "false" for any build that should talk to the real API.
VITE_USE_MOCKS=false
