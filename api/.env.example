# Copy this file to `.env` (same directory) and fill in real values for
# local development. `.env` is git-ignored — never commit it.
#
# Variables marked "SHARED" below MUST be set to the SAME value as the
# sibling `backend/` project's own `.env` — see backend/README.md "Contract
# for the FastAPI service" and this project's own README "Environment
# variables" section. This is not optional: a bridge JWT minted by the real
# Django process is only verifiable here if SHARED_JWT_SECRET matches
# byte-for-byte.

# --- Django ORM integration ------------------------------------------------
# Absolute path to the sibling backend/ directory (added to sys.path before
# django.setup()).
BACKEND_DIR=E:\Django_project\practice\GrowthReel\backend
# config.settings.local for local dev, config.settings.production in prod.
DJANGO_SETTINGS_MODULE=config.settings.local
# NOTE: there is no DATABASE_URL or DB_* variable here on purpose. When
# django.setup() runs, Django reads its OWN .env file (backend/.env,
# resolved relative to BACKEND_DIR above), so this process picks up
# whatever DB_ENGINE/DB_NAME/DB_USER/DB_PASSWORD/DB_HOST/DB_PORT are set
# there automatically — nothing to duplicate or keep in sync here. See
# backend/.env.example's "Database" section.

# --- Django <-> FastAPI bridge (SHARED with backend/.env) ------------------
SHARED_JWT_SECRET=change-me-shared-jwt-secret-min-32-bytes-of-entropy
APP_FRONTEND_URL=http://localhost:5173

# --- This service's own tokens ---------------------------------------------
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# --- Redis (SHARED with backend/.env) --------------------------------------
# Only touched by the bridge-exchange replay check (production only) and
# logout. A Redis outage never 500s unrelated requests — see
# app/core/redis_client.py.
REDIS_URL=redis://localhost:6379/0

# --- CORS -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Environment switch ------------------------------------------------------
# "local" or "production". Controls: Secure cookie flag, HSTS header,
# Redis-backed bridge-jti replay check (production only; local relies on
# the 60s JWT exp alone — see app/core/redis_client.py docstring).
ENV=local
